# Server
NODE_ENV=development
PORT=5000

# Database (local MongoDB by default — set to your Atlas URI for production)
MONGODB_URI=mongodb://127.0.0.1:27017/campus_boda

# Auth (JWT) — replace in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# M-Pesa (Daraja) — "simulation" runs locally without credentials;
# switch to "sandbox" (or "production") once you have Safaricom app credentials
MPESA_ENV=simulation
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# For sandbox/production this must be a PUBLIC url Safaricom can reach (e.g. ngrok)
MPESA_CALLBACK_URL=http://127.0.0.1:5000/api/v1/payments/mpesa/callback
